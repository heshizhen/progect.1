# ============================================================================
# 1. 本地 MySQL 数据库连接配置（推荐：直接使用你电脑上的 MySQL）
# 先在 MySQL 中执行 mysql/0001_init_once_mysql.sql 建库建表，再填入下方连接串：
# 格式：mysql://用户名:密码@127.0.0.1:3306/project_once
# （注：若暂未配置 MYSQL_URL，项目会自动启用服务端内存存储模式，也可直接双开浏览器联调）
# ============================================================================
MYSQL_URL=mysql://root:your_mysql_password@127.0.0.1:3306/project_once

# ============================================================================
# 2. 服务端匿名身份 HMAC 签名密钥（仅服务端使用，严禁泄露到客户端）
# ============================================================================
ONCE_IDENTITY_HMAC_SECRET=replace-with-at-least-32-chars-random-secret
